PORT=5001
JWT_SECRET=change-this-to-a-long-random-string
MONGODB_URI=mongodb://127.0.0.1:27017/ai-medical-therapy
# Also accepted: MONGO_URI

# First boot seeds a default Admin if missing: admin@gmail.com / admin123 (change in production).

# Landing “Send message” notifications (defaults to admin@gmail.com if unset)
ADMIN_NOTIFY_EMAIL=admin@gmail.com

# Optional: email when doctor is approved/rejected (leave blank to log only)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@yourdomain.pk

FRONTEND_URL=http://localhost:5173

# Optional: landing page “uptime” line (not computed from DB)
LANDING_UPTIME_LABEL=99.9%
